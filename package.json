    "demo": "DATA_MODE=demo node server/index.js --dev",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "express": "^5.3.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "vite": "^8.3.8"
  }
}
