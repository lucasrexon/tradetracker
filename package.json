{
  "name": "tradetracker",
  "version": "0.1.0",
  "private": true,
  "description": "Live 3D trade tracker that watches company news and five fundamental pillars to check the state of every trade.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node server/index.js --dev",
    "build": "vite build",
