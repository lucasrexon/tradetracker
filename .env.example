# Copy to .env and fill in. Every value is optional.

# Massive (formerly Polygon.io) API key: https://massive.com/dashboard/api-keys
# Without a key the app runs in DEMO mode with synthetic data.
MASSIVE_API_KEY=

# auto | live | demo   (auto = live when MASSIVE_API_KEY is set)
DATA_MODE=auto

# Requests per minute allowed by your Massive plan (free tier = 5).
MASSIVE_RPM=5

# SEC EDGAR asks automated clients to identify themselves.
# Put your app name and a contact address here, e.g. "TradeTracker you@example.com".
SEC_USER_AGENT=TradeTracker/0.1 (self-hosted research tool)

# Refresh intervals (minutes)
NEWS_REFRESH_MIN=10
PRICE_REFRESH_MIN=15

PORT=3000
HOST=127.0.0.1
